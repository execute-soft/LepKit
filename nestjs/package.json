{
  "name": "executesoft",
  "version": "1.0.0",
  "license": "MIT",
  "description": "NestJS backend API",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npx tsc -p apps/api/tsconfig.app.json && npx concurrently -k -n tsc,nodemon \"npx tsc --watch --preserveWatchOutput -p apps/api/tsconfig.app.json\" \"npx nodemon --config apps/api/nodemon.json\"",
    "build": "npx nx build api",
    "build:api": "npx nx build api --configuration=production",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate apps/api/src/migrations/Migration -d apps/api/src/config/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d apps/api/src/config/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d apps/api/src/config/data-source.ts",
    "seed": "npx ts-node -P apps/api/tsconfig.app.json apps/api/src/seed.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.23",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.1.14",
    "resend": "^6.12.3",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.30",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nx/devkit": "22.7.2",
    "@nx/js": "22.7.2",
    "@nx/node": "22.7.2",
    "@nx/webpack": "22.7.2",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "20.19.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "nx": "22.7.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.3",
    "webpack-cli": "^5.1.4"
  }
}
